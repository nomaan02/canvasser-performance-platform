# Settings for `npm run sync` (the demo needs none of these).
# 1. Copy this file and name the copy ".env".
# 2. Fill in your own values. Never commit .env; it is listed in .gitignore.

# Your CRM's address, WITHOUT /webservice.php on the end
CRM_BASE_URL=https://your-crm.example.com

# A CRM user and that user's "Access Key"
# (in vtiger: click your avatar > My Preferences > scroll to "Access Key")
CRM_USER=your-crm-username
CRM_ACCESS_KEY=your-access-key

# The time zone your CRM stores dates in: Europe/London or UTC
CRM_TIMEZONE=Europe/London

# Optional: only fetch leads changed since this date (ISO format)
# SYNC_SINCE=2026-11-01T00:00:00Z

# Optional: your own field and status mappings (see the config folder)
# CRM_FIELD_MAP=config/crm-fields.json
# CRM_STATUS_MAP=config/status-map.json

# To try `npm run sync` against the mock CRM instead:
#   1. In one terminal:  npm run mock-crm
#   2. Use CRM_BASE_URL=http://127.0.0.1:8787  CRM_USER=demo  CRM_ACCESS_KEY=demo-access-key
